{# Optimierte Feedback-Sektion mit Macro-Nutzung #}

{% import "GuardiansBasicB2B::Category.Macros.render-rating" as Rating %}


{# Read existing comments and their aggregate once each. #}
{% set itemFeedbacks = getFeedbackItemList(itemId, 1, 20) %}
{% set ratingsAverage = getListFeedbackAverages(itemId)  %}

{# Fallback-Werte #}
{% set ratingsCount = [0, 0, 0, 0, 0] %}
{% set ratingsPercent = [0, 0, 0, 0, 0] %}

{% set averageTotal = ratingsAverage.ratingsCountTotal ?? null %}
{% set hasAverage = averageTotal is not iterable and averageTotal is not same as(true) and averageTotal matches '/^[0-9]+$/D' and averageTotal > 0 %}
{% set listTotal = itemFeedbacks.totalsCount ?? null %}
{% set hasList = listTotal is not iterable and listTotal is not same as(true) and listTotal matches '/^[0-9]+$/D' and listTotal > 0 %}
{% if pdpFeedback|default(false) and not hasList %}
    {% for entry in itemFeedbacks.entries|default([]) %}
        {% if entry.isVisible == 'true' %}{% set hasList = true %}{% endif %}
    {% endfor %}
{% endif %}
{% if hasAverage %}
    {% set ratingsCount = [
        ratingsAverage.ratingsCountOf1,
        ratingsAverage.ratingsCountOf2,
        ratingsAverage.ratingsCountOf3,
        ratingsAverage.ratingsCountOf4,
        ratingsAverage.ratingsCountOf5
    ] %}
    {% set ratingsPercent = [
        (ratingsCount[0] / ratingsAverage.ratingsCountTotal * 100),
        (ratingsCount[1] / ratingsAverage.ratingsCountTotal * 100),
        (ratingsCount[2] / ratingsAverage.ratingsCountTotal * 100),
        (ratingsCount[3] / ratingsAverage.ratingsCountTotal * 100),
        (ratingsCount[4] / ratingsAverage.ratingsCountTotal * 100)
    ] %}
{% endif %}

{% set hasFeedback = hasAverage or hasList or pdpFeedbackCount|default(0) > 0 %}
{% if not pdpFeedback|default(false) or hasFeedback %}
{% if pdpFeedback|default(false) %}<div class="container"><div class="row"><div class="col-12"><hr class="hr-style2">{% endif %}
<section class="feedback-container">
    <div class="container-rating">
        <div class="row">
            <div class="col-12">
                <div class="title-rating-main mb-4 d-flex align-items-center flex-wrap">
                    <div class="d-inline-block hhdh" id="quickrating">
                        {{ trans("GuardiansBasicB2B::Template.ratingtitle") }}
                    </div>
                    {% if not pdpFeedback|default(false) or hasAverage %}{{ Rating.renderRating(ratingsAverage.averageValue, 5) }}{% endif %}
                </div>
            </div>
        </div>

        {% if not pdpFeedback|default(false) or hasAverage %}
        <div class="row {% if longDescription %}openable-feedback{% endif %}">
            <div class="{% if longDescription %}col-12 col-md-6{% else %}col-12 col-lg-6 col-xlg-4{% endif %}">
                <div class="feedback-container">
                    {% if ratingsAverage.ratingsCountTotal == 0 %}
                        <p class="mt-0">{{ trans("GuardiansBasicB2B::Template.norating") }}</p>
                    {% endif %}
                    <div class="feedback-bars">
                        {% for i in 5..1 %}
                            <div class="feedback-bar-wrap">
                                <p class="feedback-bar-text-before">{{ i }} <i class="icon-star"></i></p>
                                <div class="feedback-bar">
                                    <div class="feedback-bar-fill" style="width: {{ ratingsPercent[i - 1]|number_format(1, '.', '') }}%;"></div>
                                </div>
                                <p class="feedback-bar-text-after">&nbsp;{{ ratingsCount[i - 1] }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

        </div>

        {% endif %}
        {% if longDescription %}
            <div class="row">
                <div class="col-12">
                    <button data-eg-param="html, openfeedback-on" data-eg-event="click" data-eg-handler="tgClass" class="btn btn-primary btn-openfeedback">
                        {{ trans("GuardiansBasicB2B::Template.openreviews") }}
                    </button>
                </div>
            </div>
        {% endif %}

        {% if hasList %}
            <div class="row">
                <div class="col-xs-12 px-3">
                    <div class="feedback-list mt-3">
                        {% include "GuardiansBasicB2B::DynamicContent.DynamicFeedbacks" with { 'itemId': itemId, 'feedbackItems': itemFeedbacks } %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% if pdpFeedback|default(false) %}<hr class="hr-style2"></div></div></div>{% endif %}
{% endif %}