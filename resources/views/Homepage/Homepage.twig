{% extends getPartial('page-design') %}


{% import "Ceres::PageDesign.Macros.LayoutContainer" as LayoutContainer %}

{% set showDefaultHomepage = config("Ceres.default.homepage") %}
{% set companyLogo  = config("Ceres.header.company_logo") %}
{% set companyName  = trans("Ceres::Template.headerCompanyName") %}

{% block PartialHead %}
    <meta name="description" content="Das Mode Online Outlet bietet Fashion, Mode, Marken-Schuhe, Taschen, Kindermode & Beauty günstig für Damen, Herren & Kinder in einer großen Auswahl an.">
    {% set homepageSeoPage = seoPage is defined ? seoPage : createSeoPage(services.template.getCurrentTemplate()) %}
    <meta name="robots" content="{{ homepageSeoPage.robots('', config('Ceres.meta.robots_home'), forceNoIndex is defined and forceNoIndex) }}">
    <meta name="keywords" content="Schuhe Outlet,Marken Outlet,Sneaker Outlet,Nike Schuhe,Jeans Outlet,Markenschuhe Outlet,Online Shopping,Outlet,Fashion Günstig,Online Outlet,Lagerverkauf Online,Günstige Mode,Günstige Schuhe,Outlet46,Online Deals,Mode Sparen,Schuhe sparen,Sonnenbrille sparen,Markenbekleidung,Marken Kosmetik,Parfum Outlet,Parfum Sparen,Möbel Outlet,Teppich Outlet,Unterwäsche günstig">
    <meta property="og:title" content="{{ companyName }}"/>
    <meta property="og:type" content="article"/>
    <meta property="og:url" content="{{ services.webstoreConfig.getWebstoreConfig().domainSsl }}"/>
     <meta property="og:image" content="https://b2b.outlet46.de/layout/outlet46-reboot/img/logo-outlet46x2.png"/>
 
    <script type="application/ld+json">
        {"@context": "http://schema.org","@type": "WebSite","url": "{{ services.webstoreConfig.getWebstoreConfig().domainSsl }}","potentialAction":{"@type": "SearchAction","target": "{{ services.webstoreConfig.getWebstoreConfig().domainSsl }}/search?query={search_term}","query-input": "required name=search_term"}}
    </script>

    <title>Günstige Mode & Marken-Schuhe im Online Outlet | Outlet46</title>
{% endblock %}

{% block PageBody %}

    <div data-eg-handler="initItemSlider" data-eg-event="load">
        <section class="section-slider-wrap">   
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="section-slider">
                        {% for i in 1..6 %}    
                            {% if config("GuardiansBasicB2B.homeSliderImageDesktop_"~ i) is not empty %}
                                <div class="home-slider-main">
                                    <div class="home-slider-link-wrap">
                                        <h3 style="color: {{ config("GuardiansBasicB2B.homeSliderTxtColor_"~ i) }};">{{ config("GuardiansBasicB2B.homeSliderTxt_"~ i) | raw }}</h3>
                                        <a href="{{ config("GuardiansBasicB2B.homeSliderLink_"~ i) }}" title="{{ config("GuardiansBasicB2B.homeSliderLinkTxt_"~ i) }}">
                                            {{ config("GuardiansBasicB2B.homeSliderLinkTxt_"~ i) }} &raquo;
                                        </a>
                                    </div>
                                    <picture class="lozad" data-iesrc="{{ config("GuardiansBasicB2B.homeSliderImageDesktop_"~ i) }}" data-alt="{{ config("GuardiansBasicB2B.homeSliderTxt_"~ i) }}">
                                        <source srcset="{{ config("GuardiansBasicB2B.homeSliderImageDesktop_"~ i) }}" media="(min-width: 768px)">
                                        <source srcset="{{ config("GuardiansBasicB2B.homeSliderImageMobile_"~ i) }}" media="(min-width: 0px)">
                                    </picture>
                                </div>    
                            {% endif %} 
                       {% endfor %}
                        </div>
                    </div>
                </div>
            </div> 
        </section>
        <section class="section-banner-first">
            <div class="container">
                <div class="row">
                    {% for i in 1..3 %}
                        {% if config("GuardiansBasicB2B.homeBannerImage_"~ i) is not empty %}
                        <div class="col-12 col-md-4">
                            <a href="{{ config("GuardiansBasicB2B.homeBannerLink_"~ i) }}" title="">
                                <img src="" data-src="{{ config("GuardiansBasicB2B.homeBannerImage_"~ i) }}" alt="{{ config("GuardiansBasicB2B.homeBannerLinkTxt_"~ i) }}" class="lozad" />
                                <span>{{ config("GuardiansBasicB2B.homeBannerLinkTxt_"~ i) }} &raquo;</span>
                            </a>
                        </div>
                        {% endif %} 
                    {% endfor %}
                </div>
            </div>
        </section>
        <section class="section-usp-home">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="home-usp-wrap">
                            <div class="row">
                                <div class="col-12 col-md-4 slide-vert-top activeSlideVert">
                                    <div class="d-flex align-items-center justify-content-center home-usp-box">
                                        <div class="home-usp-icon">
                                            <span class="icon-star3"></span>
                                        </div>
                                        <div class="home-usp-txt">
                                            <span>{{ config("GuardiansBasicB2B.homeUspHead_1") }}</span>
                                            <span>{{ config("GuardiansBasicB2B.homeUspTxt_1") }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 slide-vert-top">
                                    <div class="d-flex align-items-center justify-content-center home-usp-box">
                                        <div class="home-usp-icon">
                                            <span class="icon-star3"></span>
                                        </div>
                                        <div class="home-usp-txt">
                                            <span>{{ config("GuardiansBasicB2B.homeUspHead_2") }}</span>
                                            
                                            <span>{{ config("GuardiansBasicB2B.homeUspTxt_2") |replace({':tsrate': trustedJson.response.data.shop.qualityIndicators.reviewIndicator.overallMark }) }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 slide-vert-top">
                                    <div class="d-flex align-items-center justify-content-center home-usp-box home-usp-box-last">
                                        <div class="home-usp-icon">
                                            <span class="icon-star3"></span>
                                        </div>
                                        <div class="home-usp-txt">
                                            <span>{{ config("GuardiansBasicB2B.homeUspHead_3") }}</span>
                                            <span>{{ config("GuardiansBasicB2B.homeUspTxt_3") }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>         
        <section class="section-banner-second">
            <div class="container">
                <div class="row">
                    <div class="col-12 col-md-4">
                        <a href="{{ config("GuardiansBasicB2B.homeBannerLinkSecond_1") }}" title="{{ config("GuardiansBasicB2B.homeBannerLinkTxtSecond_1") }}" class="middle-img-txt">
                            <img src="" data-src="{{ config("GuardiansBasicB2B.homeBannerImageSecond_1") }}" alt="{{ config("GuardiansBasicB2B.homeBannerLinkTxtSecond_1") }}" class="lozad" />
                            <span>{{ config("GuardiansBasicB2B.homeBannerLinkTxtSecond_1") }} &raquo;</span>
                        </a>
                    </div>
                    <div class="col-12 col-md-8">
                        <a href="{{ config("GuardiansBasicB2B.homeBannerLinkSecond_2") }}" title="{{ config("GuardiansBasicB2B.homeBannerLinkTxtSecond_2") }}" class="right-bottom-txt">
                            <img src="" data-src="{{ config("GuardiansBasicB2B.homeBannerImageSecond_2") }}" alt="{{ config("GuardiansBasicB2B.homeBannerLinkTxtSecond_2") }}" class="lozad" />
                            <span>{{ config("GuardiansBasicB2B.homeBannerLinkTxtSecond_2") }} &raquo;</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
  
        {# getProducer() |json_encode() #}
        <section class="section-items">
            <div class="home-slider-title">
                Sehr beliebt bei unseren Kunden
            </div>
            {# set itemListHomeTopSell = services.itemList.getItemList( "category", "41", "" ,10).documents #}
            {% set itemListHomeTopSell = services.itemList.getItemList( "tag_list", "12", "sorting.price.avg_asc" ,15).documents %}
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="home-slider-items">
                        {% for item in itemListHomeTopSell %}
                            <div class="col-12">
                                {% include "GuardiansBasicB2B::Category.Item.Partials.CategoryListItem" with { 'item': item } %}
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section-seo mt-4">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <h1 class="home-seo-h1 text-center">-</h1>
                        <div class="home-seo-txt seo-txt-format transition">
                         
                        </div>
                            <div class="text-center d-md-none mt-4">
                                <button class="btn btn-secondary btn-show-readmore">Mehr lesen</button>
                            </div>
                        </div>   
                </div>
            </div>
        </section>
    </div> 
          
 {% endblock %}
