                <script src="{{ plugin_path('GuardiansBasicB2B') }}/js/facets.min.js?v=2" defer></script>
            {% endif %}
            {# Keep the existing page selection and Ceres-owned jQuery exception. #}
            {# Asset URLs are generated from asset-versions.json by npm run build. #}
            {% set themePageScript = 'main.min.js?v=7' %}
            {% set themeNeedsJquery = true %}
            {% set matrixInPageScript = false %}
            {% if "amazon" in currentRequestUri or "expressCheckoutReview" in currentRequestUri or (not isBasketCategory and category.id in mainjs) %}
            {% elseif isBasketCategory or category.id in vuejs %}
                {% set themeNeedsJquery = false %}
            {% elseif currentTemplate in vuePages|keys or category.id in nojs %}
            {% elseif rendersItemGrid is defined and not rendersItemGrid %}
            {% elseif category.id or isSearch %}
                {% set themePageScript = 'cat.min.js?v=11' %}
            {% elseif isItem %}
                {% set themePageScript = 'item.min.js?v=15' %}
                {% set matrixInPageScript = true %}
            {% endif %}
            {% if themeNeedsJquery %}
                <script src="{{ plugin_path('GuardiansBasicB2B') }}/js/jquery-3.7.1.min.js?v=1"></script>
            {% endif %}
            <script src="{{ plugin_path('GuardiansBasicB2B') }}/js/core.min.js?v=31" data-eg-magiczoom-src="{{ plugin_path('GuardiansBasicB2B') }}/js/magiczoom.min.js?v=1" data-eg-matrix-src="{{ plugin_path('GuardiansBasicB2B') }}/js/matrix.min.js?v=6" defer></script>
            {% if isItem and not matrixInPageScript %}
                {# A PDP routed to another page bundle still needs the matrix before it. #}
                <script src="{{ plugin_path('GuardiansBasicB2B') }}/js/matrix.min.js?v=6" data-eg-matrix defer></script>
            {% endif %}
            <script src="{{ plugin_path('GuardiansBasicB2B') }}/js/{{ themePageScript }}"{% if not themeNeedsJquery %} data-eg-vue-logout{% endif %}{% if matrixInPageScript %} data-eg-matrix{% endif %} defer></script>
            {% if isItem %}
                {# After item.js defines mzOptions, before DOMContentLoaded initializes the gallery. #}
                <script src="{{ plugin_path('GuardiansBasicB2B') }}/js/magiczoom.min.js?v=1" data-eg-magiczoom defer></script>
            {% endif %}
            {{ LayoutContainer.show("Ceres::Script.AfterScriptsLoaded") }} 
            {% if isItem %}
                {{ LayoutContainer.show("Ceres::SingleItem.AfterScriptsLoaded") }}
            {% endif %} 
            {% include "GuardiansBasicB2B::PageDesign.Components.cookiebar" %}
            {% if category.id in wkbkasse %}
                <link rel="stylesheet" href="{{ plugin_path('AmazonPayCheckout') }}/css/amazon-pay.min.css" />
                <script src="https://static-eu.payments-amazon.com/checkout.js" defer></script>
                <script src="{{ plugin_path('AmazonPayCheckout') }}/js/amazon-pay.min.js"></script>
            {% endif %}
            {% if isShopBuilder %}
                {% else %}
            {% include "GuardiansBasicB2B::PageDesign.Components.b2babfrage" ~ langCodeMap[lang] %}
            {% endif %}
            <div class="ccklayer"></div> 
             {% include "GuardiansBasicB2B::PageDesign.Components.ContactWidget" %}
             {# Contact behavior is included once in the globally deferred core. #}
            {% if showNewsletter %}
                {% include "GuardiansBasicB2B::PageDesign.Components.NewsletterPopup" with {
                    newsletterUrl: 'https://b2b.outlet46.de/' ~ newsletterPaths[lang] ~ '/',
                    consentRequired: ceresConfig.global.blockCookies|default(false)
                } %}
            {% endif %}
{% endif %}
    </body> 
</html>
