<html lang="{{ lang }}" prefix="og: http://ogp.me/ns#"{% if isQuickView and not publicLogoutPage %} data-eg-logout-home="{{ urls.home|default('/') }}"{% if services.customer.getContactId() > 0 %} data-eg-private-member{% endif %}{% endif %}>
    <head>
        {% if isQuickView %}
        <script data-eg-session-history>
        (() => {
            const root = document.documentElement;
            const home = root.getAttribute('data-eg-logout-home');
            const conceal = () => root.style.setProperty('display', 'none', 'important');
            const fromHistory = performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
            const wasMember = root.hasAttribute('data-eg-private-member');
            // Keep only a logout generation on personal history entries, never keys, URLs or customer data.
            const generation = () => {
                try { return localStorage.getItem('eg:lastLogout') || ''; } catch (_) { return null; }
            };
            let entry = history.state?.egMemberGeneration;
            if (wasMember && !fromHistory) {
                entry = generation();
                history.replaceState({...history.state, egMemberGeneration: entry}, '');
            }
            async function restore() {
                conceal();
                if (home === null) {
                    location.reload();
                    return;
                }
                // Ceres or another tab can end the session independently of the theme button.
                // Check IO before revisiting a personal URL that may still carry a valid order key.
                if (typeof entry === 'string' && entry === generation()) {
                    try {
                        const response = await fetch('/rest/io/customer/', {
                            cache: 'no-store', credentials: 'same-origin', redirect: 'error', signal: AbortSignal.timeout(8000)
                        });
                        const contact = response.status === 200 ? await response.json() : null;
                        if (!contact?.error && /^[1-9]\d*$/.test(contact?.data?.id)) {
                            location.reload();
                            return;
                        }
                    } catch (_) { /* Unconfirmed session: take the public fallback. */ }
                }
                location.replace(location.origin + (/^\/(?:[a-z]{2}\/?)?$/.test(home) ? home : '/'));
            }
            if (home !== null && fromHistory && (wasMember || entry !== undefined)) {
                restore();
                return;
            }
            let concealed = false;
            window.addEventListener('pagehide', event => {
                if (event.persisted && (wasMember || document.querySelector('.btn-login-open.isLoggedIn, .loginpreview-register [data-eg-handler="logoutUser"]'))) {
                    concealed = true;
                    conceal();
                }
            });
            window.addEventListener('pageshow', event => {
                if (event.persisted && concealed) restore();
            });
        })();
        </script>
