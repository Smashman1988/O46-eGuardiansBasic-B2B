{# ======================  shipping-free-meter.twig (B2B Minimum Order = NET)  ====================== #}
{% set MIN_ORDER_NET = 199.00 %}

{% set currencyData = services.checkout.getCurrencyData %}
{% set currencyCode = currencyData.name %}

<div id="o46-min-order"
     class="o46-free-ship is-hidden"
     data-cur="{{ currencyCode }}"
     data-limit="{{ '%0.2f'|format(MIN_ORDER_NET) }}"
     aria-live="polite" aria-atomic="true">
  <div class="o46-bar-wrap" role="progressbar"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="o46-bar"></div>
    <div class="o46-bar-cap"></div>
  </div>
  <p class="o46-free-ship-text">
    <span class="o46-remaining"></span>
  </p>
</div>

<script>
(function(){
  if (window.__O46_MINORDER_METER__) return;
  window.__O46_MINORDER_METER__ = true;

  function $(s,c){ return (c||document).querySelector(s); }
  function n(v){ v = Number(v); return isFinite(v) ? v : 0; }
  function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }
  function money(v,cur){
    try{
      return new Intl.NumberFormat(
        document.documentElement.lang || 'en-US',
        { style:'currency', currency: cur || 'EUR' }
      ).format(n(v));
    } catch(e){
      v = n(v);
      return v.toFixed(2) + ' ' + (cur || 'EUR');
    }
  }

  function updateFrom(items, session){
    var box = $('#o46-min-order');
    if (!box) return;

    var basket = session && session.data && session.data.basket;
    var net = basket && basket.itemSumNet;
    if (!Array.isArray(items) || !items.length || !basket || basket.currency !== 'EUR' ||
        net == null || net === '' || !Number.isFinite(Number(net))){
      box.classList.add('is-hidden');
      return;
    }
    var cur = 'EUR';
    var limit = n(box.getAttribute('data-limit')) || 199;
    net = Number(net);
    var remaining = Math.max(0, limit - net);
    var percent   = net >= limit ? 100 : (100 * net / limit);
    percent = clamp(percent, 0, 100);

    box.classList.remove('is-hidden');

    var barWrap = $('.o46-bar-wrap', box),
        bar     = $('.o46-bar', box),
        cap     = $('.o46-bar-cap', box),
        txt     = $('.o46-remaining', box);

    bar.style.width = percent.toFixed(2) + '%';
    barWrap.setAttribute('aria-valuenow', percent.toFixed(0));
    cap.textContent = money(limit, cur);

    // --- important: restore done-state styling (green bar etc.) ---
    if (net < limit){
      box.classList.remove('o46-free-ship--done');
      txt.textContent =
        money(remaining, cur) +
        ' remaining to reach the minimum order value of ' + money(limit, cur) +
        ' (net).';
    } else {
      box.classList.add('o46-free-ship--done');
      txt.textContent =
        'Minimum order value reached – you can proceed to checkout.';
    }
    // ----------------------------------------------------------------
  }

  window.addEventListener('o46:basket-updated', function(e){
    try{
      var d = e.detail || {};
      updateFrom(Array.isArray(d.items) ? d.items : [], d.session || null);
    }catch(_){}
  });
})();
</script>
