{% set itemListHomeTopSell = services.itemList.getItemList( "tag_list", "7", "sorting.price.avg_asc" ,50).documents %}            
<div class="row mt-4">
    <div class="col-xs-12">
        <div class="category-product-list row" data-eg-handler="initCatItemEvents" data-eg-event="load">
            {% set tagListAttributeMaps = (cardAttributeMap ?? null) is null
                ? getCardAttributeMaps(itemListHomeTopSell|default([])|map(item => item.data.variation.itemId))
                : [] %}
            {%- for item in itemListHomeTopSell %}
                <div class="col-6 col-sm-6 col-md-4 col-lg-3 col-xxlg-25 m-b-3">
                    {% include "GuardiansBasicB2B::Category.Item.Partials.CategoryListItem" with { 'item': item, 'shippingCat': shippingCat, 'cardAttributeMap': cardAttributeMap ?? tagListAttributeMaps[item.data.variation.itemId] ?? null } %}
                </div>
            {% endfor %}    
        </div>
    </div>
</div>