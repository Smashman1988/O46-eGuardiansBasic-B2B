{# Shared card; the legacy first-page entry point selects eager images explicitly. #}
{% set cardEagerImages = cardEagerImages|default(false) -%}
{% set itemUrl = item.data | itemURL -%}
{% set currencycheck = currencycheck ?? 'EUR' -%}
{% set img = item.data.images.all[0].urlPreview ?? '' -%}
{% set cardHasPriorityImage = not cardEagerImages and cardPriorityImage|default(false) and img is not empty -%}
{% set itemName = item.data | itemName -%}
{% if item.data.prices.default.unitPrice.value and item.data.prices.rrp.unitPrice.value is not empty -%}
    {% set percent = ((1 - item.data.prices.default.unitPrice.value / item.data.prices.rrp.unitPrice.value) * -100) | number_format(dezimalcount, ',', '.') -%}
{% endif -%}
{% set isSustainable = (item.data.tags is iterable ? item.data.tags | filter(tag => tag.id == 284) : []) | length > 0 -%}
{% import "GuardiansBasicB2B::Category.Macros.render-rating" as Rating -%}
{% set feedbackRatingDecimal = item.data.item.feedbackDecimal ?? 0 -%}
{% set feedbackCount = item.data.item.feedbackCount ?? 0 -%}
{% set rawLogo = item.data.item.manufacturer.logo -%}
{% set vendorlogo = rawLogo | replace({'https://cdn02.outlet46.de/frontend/vendor/': cardEagerImages ? plugin_path('GuardiansBasicB2B') ~ '/images/vendors/' : (cardVendorLogoBase ?? (plugin_path('GuardiansBasicB2B') ~ '/images/vendors/'))}) -%}
<div class="cat-item has-rrp has-variations" data-eg-item="{{ item.data.variation.itemId }}"><div class="article-header text-center col-12 cat-article-header-info"><span class="col-7"><span class="item-action i-action-sale">{{ percent }}%</span>
{%- if isSustainable %} <span class="item-action i-action-nachhaltig-cat">{{ translations.tSustainability }}</span>{% endif -%}
{% if feedbackCount > 0 %}<span class="item-action2">{{ Rating.renderRating(feedbackRatingDecimal, 5) }}</span>{% endif -%}
</span><span class="col-5">
{%- if vendorlogo is not empty -%}
    {% if cardEagerImages %}<img src="{{ vendorlogo }}" class="cat-logo" width="50px" height="50px" alt="{{ item.data.item.manufacturer.name }} Logo" title="{{ item.data.item.manufacturer.name }}">{% else %}<img src="" data-src="{{ vendorlogo }}" class="lozad cat-logo" width="50px" height="50px" alt="{{ item.data.item.manufacturer.name }} Logo" title="{{ item.data.item.manufacturer.name }}">{% endif -%}
{% elseif rawLogo is not empty -%}
    {% if cardEagerImages %}<img src="{{ rawLogo }}" class="cat-logo" width="50px" height="50px" alt="{{ item.data.item.manufacturer.name }} Logo" title="{{ item.data.item.manufacturer.name }}">{% else %}<img src="" data-src="{{ rawLogo }}" class="lozad cat-logo" width="50px" height="50px" alt="{{ item.data.item.manufacturer.name }} Logo" title="{{ item.data.item.manufacturer.name }}">{% endif -%}
{% endif -%}
</span></div><div class="article-body cat-item-image text-center {% if isShoeCategory %}cat-item-shoe{% endif %}"><a class="product-list article a" href="{{ itemUrl }}{% if currencycheck != 'EUR' %}?currency={{ currencycheck }}{% endif %}" title="{{ itemName }}"><picture>
{%- if cardEagerImages -%}
<source type="image/avif" srcset="{{ img }}.avif"><img decoding="async" src="{{ img }}" width="225px" height="300px" alt="{{ itemName }}" title="{{ itemName }}">
{%- else -%}
<source srcset="{% if cardHasPriorityImage %}{{ img }}.avif{% endif %}" type="image/avif"{% if not cardHasPriorityImage %} data-srcset="{{ img }}.avif" class="lozad"{% endif %}><img src="{% if cardHasPriorityImage %}{{ img }}{% endif %}" decoding="async"{% if cardHasPriorityImage %} loading="eager" fetchpriority="high"{% else %} data-src="{{ img }}"{% endif %} width="225px" height="300px"{% if not cardHasPriorityImage %} class="lozad"{% endif %} alt="{{ itemName }}" title="{{ itemName }}">
{%- endif -%}
</picture></a></div><div class="article-footer cat-item-data ptpb"><div class="tcenter cat-item-sizes"><span class="outlet-green sizebox">{{ translations.tAvailSizes }}</span><div class="cat-attr-sizes">
{%- include "GuardiansBasicB2B::Category.Item.Partials.CategoryAttributes" with { 'itemId': item.data.variation.itemId, 'itemFlag': item.data.item.flagTwo, 'transLabels': transLabels, 'cardAttributeMap': cardAttributeMap ?? null } only -%}
</div></div><a href="{{ itemUrl }}{% if currencycheck != 'EUR' %}?currency={{ currencycheck }}{% endif %}" class="product-list article a thumb-title cat-item-name mb-0" title="{{ itemName }}">{{ itemName }}</a><div class="col-12 paddinlr"><span class="bold font-12">{{ translations.tStatt }} <span class="cat-rrp-price">{{ item.data.prices.rrp.unitPrice.formatted }}*</span></span> <span class="bold outlet-green font-18">{{ item.data.prices.default.unitPrice.formatted }}</span></div><button class="btn-primary linkabso idwk-80" data-href="https://b2b.outlet46.de{{ itemUrl }}?quickViewItem=true"><span class="icon-online-shopping-cart mr-2"></span>{{ translations.tInBasket }}</button></div></div>
