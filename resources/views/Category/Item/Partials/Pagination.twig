{% set compactPagination = compactPagination|default(false) %}
{% set publicQuery = compactPagination ? {'quickViewItem': null} : {} %}
{% if pageMax > 1 %}
    {% set canonicalURL = services.url.getCanonicalURL() %}
    {% set showPageAt = currentPage %}
        <ul class="pagination list-no-style{% if compactPagination and pageMax >= 100 %} paging-many{% endif %}">
                {% if currentPage > 0 %}{% set pageLabel = trans("GuardiansBasicB2B::Template.page") %}
            <!-- PREV LINK -->
{% if compactPagination and currentPage == 1 %}
            <li class="page-item paging-limit" aria-hidden="true">
                <span class="icon-left-open-big"></span>
            </li>
{% endif %}
            {% if (currentPage - 1) < 2 %}
            <li class="page-nextprev page-item{% if currentPage < 2 %} disabled{% endif %}">
                <a class="page-link" href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': null })) }}" title="{{ compactPagination ? pageLabel ~ ' 1' : trans("GuardiansBasicB2B::Template.lastpage") }}">
                    <span class="icon-left-open-big"{% if compactPagination %} aria-hidden="true"{% endif %}></span>
                </a>
            </li>
            {% else %}
            <li class="page-nextprev page-item{% if currentPage < 2 %} disabled{% endif %}">
                <a class="page-link" href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': currentPage - 1  })) }}" title="{{ compactPagination ? pageLabel ~ ' ' ~ (currentPage - 1) : trans("GuardiansBasicB2B::Template.lastpage") }}">
                    <span class="icon-left-open-big"></span>
                </a>
            </li>
            {% endif %}
            <!-- ./PREV LINK -->
 
            <!-- FIRST PAGE LINK -->
            <li class="page-item {% if currentPage == 1 %}active{% endif %}">
                <a class="page-link" 
                   href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': null })) }}" {% if compactPagination and currentPage == 1 %}aria-current="page" {% endif %}title="{{ pageLabel }} 1">1</a>
            </li>
            {% if currentPage > 3 %}
                <li class="page-item page-link">...</li>
            {% endif %}
            <!-- ./FIRST PAGE LINK -->

            <!-- PAGINATION -->

            {% if not compactPagination and currentPage == pageMax and currentPage > 2 %}
                <li class="page-item">
                    <a class="page-link"
                       href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': currentPage - 2 })) }}" title="{{ pageLabel }} {{ currentPage - 2 }}">{{ currentPage - 2 }}</a>
                </li>
            {% endif %}
            
            {% if currentPage > 1 %}
                {% if (currentPage - 1) > 1 %}
                <li class="page-item{% if compactPagination and currentPage > 3 and currentPage < pageMax %} paging-neighbor{% endif %}">
                    <a class="page-link"
                       href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': currentPage -1 })) }}" title="{{ pageLabel }} {{  currentPage - 1 }}">{{ currentPage - 1 }}</a>
                </li>
                {% endif %}
            {% endif %}
             {% if currentPage > 1 %}
                <li class="page-item active">
                    <a class="page-link" {% if compactPagination %}aria-current="page" href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': currentPage })) }}" {% endif %}title="{{ pageLabel }} {{ currentPage }}">{{ currentPage }}</a>
                </li>
            {% endif %}    
                {% if currentPage+1 <= pageMax %}
                <li class="page-item{% if compactPagination and pageMax > currentPage + 2 and currentPage > 1 %} paging-neighbor{% endif %}">
                    <a class="page-link"
                       href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': currentPage + 1 })) }}" title="{{ pageLabel }} {{ currentPage + 1 }}">{{ currentPage + 1 }}</a>
                </li>
                {% set showPageAt = currentPage + 1 %}
                {% endif %}
            <!-- ./PAGINATION -->
            
            <!-- LAST PAGE LINK -->
            {% if pageMax > showPageAt  %}
{% if not compactPagination or pageMax > showPageAt + 1 %}
                <li class="page-item page-link facet-test">...</li>
{% endif %}
                <li class="page-item facet-test">
                    <a class="page-link"
                       href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': pageMax })) }}" title="{{ pageLabel }} {{ pageMax }}">{{ pageMax }}</a>
                </li>
            {% endif %}
            <!-- ./LAST PAGE LINK -->

            <!-- NEXT LINK -->
            {% if currentPage < pageMax %}{% set nextPageLabel = trans("GuardiansBasicB2B::Template.nextpage") %}
{% if not compactPagination %}
            <li class="page-nextprev page-item disabled">
                <a class="pagination__next"
                   href="{{ canonicalURL ~ queryString({ 'page': currentPage + 1 }) }}&quickViewItem=true" title="{{ nextPageLabel }}">
                    <span class="icon-right-open-big"{% if compactPagination %} aria-hidden="true"{% endif %}></span>
                </a>
            </li>
{% endif %}
			<li class="page-nextprev page-item{% if currentPage == pageMax %} disabled{% endif %}">
                <a class="pagination__noxt"
                   href="{{ canonicalURL ~ queryString(publicQuery|merge({ 'page': currentPage + 1 })) }}" title="{{ nextPageLabel }}">
                    <span class="icon-right-open-big"{% if compactPagination %} aria-hidden="true"{% endif %}></span>
                </a>
            </li>
            {% elseif compactPagination and currentPage == pageMax %}
                <li class="page-item paging-limit" aria-hidden="true"><span class="icon-right-open-big"></span></li>
            {% endif %}
            {% endif %}
            <!-- ./NEXT LINK -->
        </ul>
{% endif %}
