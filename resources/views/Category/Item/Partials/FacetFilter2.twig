{# One request-scoped model from the existing IO result; no additional search. #}
{% set facetView = getFacetView(facets|default([]), selectedFacets|default([])) %}
{% set priceMax = request.get('priceMax') %}
{% set priceMin = request.get('priceMin') %}
{# IO restores the current language route; ignore an editorial SEO canonical override. #}
{% set facetRoute = services.url.getCanonicalURL(null, true) %}
{% set facetTexts = {
    loading: trans('GuardiansBasicB2B::Template.facetLoading'),
    result: trans('GuardiansBasicB2B::Template.facetResult'),
    error: trans('GuardiansBasicB2B::Template.facetError'),
    unavailable: trans('GuardiansBasicB2B::Template.facetUnavailable')
} %}
<section data-eg-facets data-eg-compact-facets data-eg-catid="{{ category.id }}" data-eg-searchstring="{{ request.get('query') }}" data-eg-defaultitemsperpage="{{ searchOptions.defaultItemsPerPage }}">
    <script type="application/json" data-eg-facet-data>{{ {values: facetView.values, selected: facetView.selected, texts: facetTexts}|json_encode(15)|raw }}</script>
    <div class="filter-container">
        <div class="wrap-filter-mobile">
            <div class="row filter-no-mobile"><div class="col-12 text-center">
                <button type="button" class="btn btn-primary btn-big mt-2 filter-no-desktop btnfilter-mobile-top" data-eg-btnfilter><span></span></button>
            </div></div>
            <div class="row"><div class="col-12 text-center"><div class="light-big-txt filter-head mt-xl-0">
                <button type="button" class="basket-prev-close close d-lg-none" data-eg-handler="tgClass" data-eg-event="click" data-eg-param="html,filter-open" aria-label="{{ trans('GuardiansBasicB2B::Template.facetClose') }}"><span aria-hidden="true">×</span></button>
            </div></div></div>
            <div class="wrap-filter-mobile-scrollable">
                <div class="row rowFilter">
                {% for facet in facets %}
                    <div class="col-12 colFilter {{ facet.cssClass }} facet-{{ facet.id }}" data-eg-facet-group="{{ facet.id }}">
                        <div class="cat-facet eg-dropdown">
                            <div class="btn-primary cat-facet-name eg-dropdown-value" data-eg-facet-toggle role="button" tabindex="0" aria-expanded="false">{{ facet.name }} <span class="icon-down-open-big" aria-hidden="true"></span></div>
                            <div class="eg-dropdown-content">
                                <ul class="list-no-style{% if facet.id == 2 %} facet-color d-flex{% endif %} facetgroup-{{ facet.id }}">
                                {% if facet.id == 8 %}
                                    <li>
                                        <div class="input-group m-b-1"><div class="input-group-prepend"><div class="input-group-text">{{ currencyData[currencyFormat] }}</div></div><input type="number" class="form-control facet-input-price-min" min="1" placeholder="Min." aria-label="{{ trans('GuardiansBasicB2B::Template.facetPriceMin') }}" value="{{ priceMin }}"></div>
                                        <div class="input-group m-b-1"><div class="input-group-prepend"><div class="input-group-text">{{ currencyData[currencyFormat] }}</div></div><input type="number" class="form-control facet-input-price-max" placeholder="Max." aria-label="{{ trans('GuardiansBasicB2B::Template.facetPriceMax') }}" value="{{ priceMax }}"></div>
                                        <button type="button" class="btn btn-secondary btn-small btn-block m-b-1 pricefilter">{{ trans('GuardiansBasicB2B::Template.apply') }}</button>
                                    </li>
                                {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                </div>
                <button type="button" class="btn btn-primary btn-big d-lg-none btnfilter-mobile btnfilter-mobile-bottom" data-eg-btnfilter><span></span></button>
            </div>
        </div>
    </div>
    {% if facetView.active or priceMax or priceMin %}
        <hr class="hr-style">
        <div class="row mt-2 mb-3 tcenter"><div class="col-12" data-eg-active-facets>
            <p class="category-title mb-3 d-lg-block">{{ trans('GuardiansBasicB2B::Template.selectedfilters') }}</p>
            {% if priceMax or priceMin %}
                <a href="{{ facetRoute ~ queryString({'priceMin':null, 'priceMax':null, 'page':null}) }}" class="btn btn-secondary facet-remove-btn facet-remove-price"><span class="facet-item-value facet-value-remove">{{ priceMin ~ ' ' ~ currencyData[currencyFormat] }}&nbsp;-&nbsp;{{ priceMax ~ ' ' ~ currencyData[currencyFormat] }}</span></a>
            {% endif %}
            {% for activeFacet in facetView.active %}
                <a href="{{ facetRoute ~ queryString({'facets':activeFacet.remaining ?: null, 'page':null}) }}" class="btn btn-secondary facet-remove-btn" data-eg-remove-facet="{{ activeFacet.id }}"><span class="facet-item-value facet-value-remove">{% if activeFacet.name is not null %}{{ activeFacet.name }}{% else %}{{ trans('GuardiansBasicB2B::Template.facetUnavailable') }} #{{ activeFacet.id }}{% endif %}</span></a>
            {% endfor %}
            <a href="{{ facetRoute ~ queryString({'facets':null, 'priceMin':null, 'priceMax':null, 'page':null}) }}" class="btn btn-secondary facet-remove-btn facet-remove-all"><span class="facet-item-value facet-value-remove">{{ trans('GuardiansBasicB2B::Template.resetallfilters') }}</span></a>
        </div></div>
    {% endif %}
    <p class="facet-status" role="status" aria-live="polite"></p>
    <div class="row"><div class="col-12 text-center"><button type="button" class="btn btn-primary btn-big mt-2 display-none btnfilter-desktop" data-eg-btnfilter><span></span></button></div></div>
    <hr class="hr-style">
</section>
