{% set translations = {
    tSustainability: trans("GuardiansBasicB2B::Template.sustainability"),
    tAvailSizes: trans("GuardiansBasicB2B::Template.availsizes"),
    tStatt: trans("GuardiansBasicB2B::Template.statt"),
    tInBasket: trans("GuardiansBasicB2B::Template.inbasket")
} %}
{% set transLabels = {
    availsizedeal: trans("GuardiansBasicB2B::Template.availsizedeal"),
    availsizeonesize: trans("GuardiansBasicB2B::Template.availsizeonesize"),
    morethen18: trans("GuardiansBasicB2B::Template.morethen18")
} %}
{% set currencycheck = services.checkout.getCurrencyData.name %}
{% set isShoeCategory = category.id in [44, 52] or category.parentCategoryId in [44, 52] %}
{% set cardVendorLogoBase = itemList is not empty ? plugin_path('GuardiansBasicB2B') ~ '/images/vendors/' : '' %}
<div class="category-product-list row disp-flexi">
{% set attributeMapsByItem = getCardAttributeMaps(itemList|default([])|map(item => item.data.variation.itemId)) %}
  {% for item in itemList %}
    <div class="col-6 col-sm-6 col-md-3 col-lg-3 col-xl-2 col-xlg-2 col-xxlg-2">
      {% include "GuardiansBasicB2B::Category.Item.Partials.CategoryListItem" with {
        'item': item,
        'cardAttributeMap': attributeMapsByItem[item.data.variation.itemId] ?? null,
        'currencycheck': currencycheck,
        'isShoeCategory': false,
        'cardVendorLogoBase': cardVendorLogoBase,
        'cardPriorityImage': prioritizeFirstCardImage|default(false) and loop.first,
        'translations': translations,
        'transLabels': transLabels
      } %}
    </div>
  {% endfor %}
</div>
