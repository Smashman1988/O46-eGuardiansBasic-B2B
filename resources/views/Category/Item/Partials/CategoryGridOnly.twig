{% set translations = {
    tSustainability: trans("GuardiansBasic::Template.sustainability"),
    tAvailSizes: trans("GuardiansBasic::Template.availsizes"),
    tStatt: trans("GuardiansBasic::Template.statt"),
    tInBasket: trans("GuardiansBasic::Template.inbasket")
} %}
{% set transLabels = {
    availsizedeal: trans("GuardiansBasic::Template.availsizedeal"),
    availsizeonesize: trans("GuardiansBasic::Template.availsizeonesize"),
    morethen18: trans("GuardiansBasic::Template.morethen18")
} %}
{% set currencycheck = services.checkout.getCurrencyData.name %}
{% set isShoeCategory = category.id in [44, 52] or category.parentCategoryId in [44, 52] %}
<div class="category-product-list row disp-flexi">
  {% for item in itemList %}
    <div class="col-6 col-sm-6 col-md-3 col-lg-3 col-xl-2 col-xlg-2 col-xxlg-2">
      {% include "GuardiansBasic::Category.Item.Partials.CategoryListItem" with {
        'item': item,
        'currencycheck': currencycheck,
        'isShoeCategory': false,
        'translations': translations,
        'transLabels': transLabels
      } %}
    </div>
  {% endfor %}
</div>
