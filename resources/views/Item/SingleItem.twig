<div data-item-variation class="row"
     data-eg-handler="initVariation"
     data-eg-event="load"
     data-eg-variations="{{ variationsWithAttributes | json_encode | e('html_attr') }}">

{% set sizeAttr = null %}
{% set colorAttr = null %}

{# Tokens für Attribut-Namen in deinen Sprachen #}
{% set sizeTokens  = ['größe','groesse','size','taille','taglia','dimensione','misura','tamaño','tamano'] %}
{% set colorTokens = ['farb','farbe','color','couleur','colore'] %}

{% for a in attributes %}
  {% set an = (a.name is defined and a.name ? a.name : '')|lower %}
  {% set aValuesLen = (a.values is defined and a.values ? a.values|length : 0) %}

  {# --- SIZE --- #}
  {% set isSize = false %}
  {% for t in sizeTokens %}
    {% if t in an %}{% set isSize = true %}{% endif %}
  {% endfor %}

  {% if isSize %}
    {% if sizeAttr is null %}
      {% set sizeAttr = a %}
    {% else %}
      {% set curLen = (sizeAttr.values is defined and sizeAttr.values ? sizeAttr.values|length : 0) %}
      {% if aValuesLen > curLen %}
        {% set sizeAttr = a %}
      {% endif %}
    {% endif %}
  {% endif %}

  {# --- COLOR --- #}
  {% set isColor = false %}
  {% for t in colorTokens %}
    {% if t in an %}{% set isColor = true %}{% endif %}
  {% endfor %}

  {% if isColor %}
    {% if colorAttr is null %}
      {% set colorAttr = a %}
    {% else %}
      {% set curLenC = (colorAttr.values is defined and colorAttr.values ? colorAttr.values|length : 0) %}
      {% if aValuesLen > curLenC %}
        {% set colorAttr = a %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}


{% set hasSize = sizeAttr and (sizeAttr.values is defined) and (sizeAttr.values|length > 0) %}
{% set hasColor = colorAttr and (colorAttr.values is defined) and (colorAttr.values|length > 0) %}

{% set mode = 'none' %}
{% if hasSize and hasColor %}
  {% set mode = 'size_color' %}
{% elseif hasSize %}
  {% set mode = 'size' %}
{% elseif hasColor %}
  {% set mode = 'color' %}
{% endif %}

<div class="col-md-12 padding-10-0">
  <div data-item-variation-select class="attribute-box">
    <p class="data-stock-warn"></p>

    {% if "<table" in itemData.texts.technicalData|raw %}
      <p class="size-chart-linkname">{{ trans("GuardiansBasicB2B::Template.sizetable") }}</p>
    {% endif %}

    <div class="eg-size-matrix"
         data-eg-size-matrix
         data-eg-mode="{{ mode }}"
         data-eg-size-attribute-id="{{ hasSize ? sizeAttr.attributeId : '' }}"
         data-eg-color-attribute-id="{{ hasColor ? colorAttr.attributeId : '' }}"
         data-eg-size-values="{{ hasSize ? (sizeAttr.values | json_encode | e('html_attr')) : '[]' }}"
         data-eg-color-values="{{ hasColor ? (colorAttr.values | json_encode | e('html_attr')) : '[]' }}"
         data-eg-base-variation-id="{{ itemData.variation.id }}">

      <div class="eg-size-matrix-head" style="display:flex; font-weight:700; padding:10px; background:#6b9f01; color:#fff;">
        {% if mode == 'size_color' %}
          <div style="flex:1; text-align:center;" data-eg-col="size">{{ trans("GuardiansBasicB2B::Template.sizematrix") }}</div>
          <div style="flex:1; text-align:center;" data-eg-col="color">{{ trans("GuardiansBasicB2B::Template.colormatrix") }}</div>
        {% elseif mode == 'size' %}
          <div style="flex:1; text-align:center;" data-eg-col="size">{{ trans("GuardiansBasicB2B::Template.sizematrix") }}</div>
        {% elseif mode == 'color' %}
          <div style="flex:1; text-align:center;" data-eg-col="color">{{ trans("GuardiansBasicB2B::Template.colormatrix") }}</div>
        {% endif %}

        <div style="flex:1; text-align:center;" data-eg-col="stock">{{ trans("GuardiansBasicB2B::Template.stockmatrix") }}</div>
        <div style="flex:1; text-align:center;" data-eg-col="price">{{ trans("GuardiansBasicB2B::Template.epricematrix") }}</div>
        <div style="flex:1; text-align:center;" data-eg-col="ean">{{ trans("GuardiansBasicB2B::Template.eanmatrix") }}</div>
        <div style="flex:1; text-align:center;" data-eg-col="sub">{{ trans("GuardiansBasicB2B::Template.submatrix") }}</div>
        <div style="flex:1; text-align:center;" data-eg-col="qty">{{ trans("GuardiansBasicB2B::Template.qtymatrix") }}</div>
      </div>

      {# Body bleibt leer -> JS baut IMMER korrekt (keine Doppel-Render / keine kaputten Zeilen) #}
      <div class="eg-size-matrix-body"></div>

